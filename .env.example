# Copy to .env and fill in what you have. One LLM key is required.

# --- LLM (pick one; with several set, priority is OpenAI > Anthropic > OpenRouter
#     unless COPILOT_PROVIDER says otherwise)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter: one key for Claude, GPT and hundreds of other models; also covers embeddings.
OPENROUTER_API_KEY=
# COPILOT_PROVIDER=openrouter
# COPILOT_MODEL=openai/gpt-4o             # defaults: gpt-4o / claude-sonnet-5-5 / anthropic/claude-sonnet-5.5
# Free models (ids ending in :free) are rate-limited; the copilot automatically adds two other
# free models as fallbacks. Override with a comma-separated list:
# COPILOT_FALLBACK_MODELS=google/gemma-4-31b-it:free,openai/gpt-5.6-luna

# --- RAG (optional)
# Embeddings use OpenAI, else OpenRouter, else Cohere, by which key is set. Cohere also powers reranking.
COHERE_API_KEY=
# COPILOT_EMBEDDINGS=cohere               # openai | openrouter | cohere | none
# QDRANT_URL=http://localhost:6333        # default: embedded Qdrant in ~/.cache/ai-meeting-copilot
# QDRANT_API_KEY=

# --- Audio / speech-to-text (optional)
# COPILOT_DEVICE=blackhole                # name substring or index; see `uv run copilot --list-devices`
# COPILOT_WHISPER_MODEL=small.en          # tiny.en | base.en | small.en | medium.en | large-v3
# COPILOT_LANGUAGE=en
# COPILOT_HOTWORDS=Qdrant, LangChain
# COPILOT_MIN_SILENCE_MS=900
# COPILOT_NOISE_GATE_DBFS=-55
# COPILOT_MODE=auto                       # auto | manual

# HF_TOKEN=                               # optional: faster Whisper model downloads
